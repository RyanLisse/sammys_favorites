{
  "name": "@sammys/workspace",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm exec ultracite check && pnpm run type && pnpm run test",
    "dev": "turbo run dev",
    "dev:agent-worker": "pnpm --filter @sammys/agent-worker dev",
    "dev:atelier": "pnpm --filter @sammys/atelier dev",
    "dev:commerce": "pnpm --filter @sammys/commerce dev",
    "dev:storefront": "pnpm --filter @sammys/storefront dev",
    "format": "pnpm exec ultracite fix",
    "test": "pnpm run test:root && turbo run test",
    "test:root": "node --test apps/e2e/src/*.test.ts",
    "type": "turbo run check-types",
    "check-types": "pnpm run type"
  },
  "devDependencies": {
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "ultracite": "7.9.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0"
}
