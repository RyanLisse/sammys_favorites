{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", ".medusa/**"]
    },
    "check-types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "ADMIN_CORS",
        "AGENT_WORKER_PORT",
        "ATELIER_PORT",
        "AUTH_CORS",
        "COMMERCE_PORT",
        "COOKIE_SECRET",
        "DATABASE_URL",
        "JWT_SECRET",
        "REDIS_URL",
        "STOREFRONT_PORT",
        "STORE_CORS"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
